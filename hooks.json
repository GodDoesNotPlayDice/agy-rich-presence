{
  "agy-rich-presence": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 scripts/discord_rpc_hook.py SessionStart",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/discord_rpc_hook.py PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/discord_rpc_hook.py PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/discord_rpc_hook.py PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 scripts/discord_rpc_hook.py PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 scripts/discord_rpc_hook.py Stop",
        "timeout": 5
      }
    ]
  }
}
